{
	// study-pwa 是独立构建：它引用的 vite 来自仓库根目录，与本工作区的 vite 不是同一份，
	// 混在一起类型检查会因为两份 Plugin 类型不兼容而报错。它由 vite 自己转译，无需 tsc。
	"exclude": ["study-pwa"],
	"include": ["**/*.ts", "**/*.tsx", ".react-router/types/**/*"],
	"compilerOptions": {
		"baseUrl": ".",
		"strict": true,
		"noEmit": true,
		"allowJs": true,
		"jsx": "react-jsx",
		"module": "ESNext",
		"target": "es2022",
		"skipLibCheck": true,
		"noUnusedLocals": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"moduleResolution": "bundler",
		"forceConsistentCasingInFileNames": true,
		"rootDirs": [".", "./.react-router/types"],
		"lib": ["DOM", "DOM.Iterable", "ES2022", "WebWorker"],
		"types": ["@react-router/node", "vite/client", "vite-plugin-pwa/client"],
		"paths": {
			"~/*": ["./app/*"],
			"@ryot/graphql/*": ["../../libs/graphql/src/*"],
			"@ryot/ts-utils/*": ["../../libs/ts-utils/src/*"],
			"@ryot/generated/*": ["../../libs/generated/src/*"],
			"@ryot/ts-utils": ["../../libs/ts-utils/src/index.ts"]
		}
	}
}
